<Project Sdk="Microsoft.NET.Sdk">

  <!-- ADR-0003: the Jira client references no MCP package, so its behaviour can be exercised
       against an HTTP double alone. -->

  <!-- Publishable on its own merits one day; shipping it unannounced beside the tool is not
       that decision, so a tag produces one package. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

</Project>
